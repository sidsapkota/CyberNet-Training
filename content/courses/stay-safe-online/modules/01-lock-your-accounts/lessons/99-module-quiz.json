          "area": {
            "x": 6,
            "y": 32,
            "w": 27,
            "h": 56
          }
        },
        {
          "id": "email",
          "text": "Email",
          "area": {
            "x": 37,
            "y": 32,
            "w": 27,
            "h": 56
          }
        },
        {
          "id": "music",
          "text": "Music",
          "area": {
            "x": 68,
            "y": 32,
            "w": 27,
            "h": 56
          }
        }
      ],
      "correctOptionId": "email",
      "explanation": "Email first, because it can reset all your other passwords; then give every app its own."
    },
    {
      "id": "q-manager-leak",
      "type": "multiple_choice",
      "difficulty": "core",
      "uses": [
        "unique-password-per-account",
        "password-manager"
      ],
      "prompt": "Leo gives all 30 accounts their own passwords. One leaks. What can the scammer open?",
      "image": {
        "src": "/illustrations/sso/quiz-manager-leak.svg",
        "alt": "Leo's password manager holding many different keys, with a counter reading 30, beside a game site with a red Hacked! banner.",
        "width": 340,
        "height": 146
      },
      "options": [
        {
          "id": "one",
          "text": "Just that game account"
        },
        {
          "id": "all",
          "text": "All 30 accounts"
        },
        {
          "id": "manager",
          "text": "Leo's password manager"
        }
      ],
      "correctOptionId": "one",
      "explanation": "Every account has its own password, so one leak only opens one account."
    },
    {
      "id": "q-stolen-password",
      "type": "multiple_choice",
      "difficulty": "core",
      "uses": [
        "two-step-sign-in"
      ],
      "prompt": "A leak gave a stranger your game password. Two-step sign-in is on. Can they get in?",
      "image": {
        "src": "/illustrations/sso/quiz-stolen-password.svg",
        "alt": "Far away, a stranger's laptop on your game's sign-in page with your password typed and the pointer on Next. Close by, your phone with two-step sign-in on.",
        "width": 340,
        "height": 140
      },
      "options": [
        {
          "id": "no",
          "text": "No: they'd need my phone's code"
        },
        {
          "id": "yes-password",
          "text": "Yes: the password is enough"
        },
        {
          "id": "yes-code",
          "text": "Yes: the code goes to them"
        }
      ],
      "correctOptionId": "no",
      "explanation": "The password is only step one; the code goes to your phone, which they don't have."
    },
    {
      "id": "q-code-request",
      "type": "multiple_choice",
      "difficulty": "core",
      "uses": [
        "never-share-sign-in-code"
      ],
      "prompt": "\"Game Support\" messages you about a code. What is this?",
      "image": {
        "src": "/illustrations/sso/quiz-code-request.svg",
        "alt": "Your phone: a notification reading Your sign-in code is 552 018, and a chat from Game Support asking you to tell them the code so they can check it's you.",
        "width": 340,
        "height": 176
      },
      "options": [
        {
          "id": "scam",
          "text": "A scam: real support never asks"
        },
        {
          "id": "support",
          "text": "Real support checking it's you"
        },
        {
          "id": "fine",
          "text": "Safe, if they know my username"
        }
      ],
      "correctOptionId": "scam",
      "explanation": "No real company ever asks for a sign-in code; whoever asks is trying to get into your account."
    },
