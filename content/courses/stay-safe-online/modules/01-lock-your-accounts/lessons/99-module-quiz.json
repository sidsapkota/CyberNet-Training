{
  "id": "lock-your-accounts-quiz",
  "kind": "quiz",
  "title": "Lock Your Accounts: Module Quiz",
  "order": 99,
  "passThreshold": 0.7,
  "cards": [
    {
      "id": "q-easy-or-hard",
      "type": "sort_bins",
      "difficulty": "core",
      "uses": [
        "names-and-years-guessed-early",
        "common-passwords-guessed-early",
        "passphrase"
      ],
      "prompt": "Your cousin lists four password ideas. Sort each one.",
      "bins": [
        {
          "id": "easy",
          "label": "On the guess list"
        },
        {
          "id": "hard",
          "label": "Hard to guess"
        }
      ],
      "items": [
        {
          "id": "name-year",
          "label": "Zoe2009 (her name and birth year)",
          "bin": "easy"
        },
        {
          "id": "abc",
          "label": "abc12345",
          "bin": "easy"
        },
        {
          "id": "symbols",
          "label": "S@f3ty!",
          "bin": "easy"
        },
        {
          "id": "words",
          "label": "pepper orbit willow canoe",
          "bin": "hard"
        }
      ],
      "explanation": "Names, years, common patterns and symbol swaps get tried first; four random words aren't on the guess list."
    },
    {
      "id": "q-long-enough",
      "type": "simulator",
      "difficulty": "core",
      "uses": [
        "length-makes-strong"
      ],
      "prompt": "Make an all-lowercase password last **at least a million years**.",
      "model": "password",
      "params": {},
      "controls": [
        {
          "id": "length",
          "kind": "slider",
          "label": "Length",
          "min": 4,
          "max": 20,
          "step": 1,
          "unit": " letters"
        }
      ],
      "outputs": [
        {
          "id": "strength",
          "kind": "list",
          "label": "A computer guessing it"
        }
      ],
      "goal": {
        "all": [
          {
            "target": "output",
            "id": "years",
            "op": ">=",
            "value": 1000000
          }
        ]
      },
      "explanation": "Around **16 lowercase letters** gets past a million years: each extra letter means 26 times more guesses."
    },
    {
      "id": "q-passphrase",
      "type": "multiple_choice",
      "difficulty": "core",
      "uses": [
        "passphrase",
        "song-lines-guessed-early"
