{
  "id": "inside-your-devices-final",
  "kind": "quiz",
  "title": "Inside Your Devices: Course Final",
  "order": 99,
  "passThreshold": 0.7,
  "cards": [
    {
      "id": "q-label-laptop",
      "type": "hotspot",
      "difficulty": "core",
      "prompt": "Label these four parts inside the laptop.",
      "scene": "laptop",
      "view": "open",
      "mode": "label",
      "labels": [
        {
          "part": "heat-pipe",
          "label": "Heat pipe"
        },
        {
          "part": "battery-connector",
          "label": "Battery connector"
        },
        {
          "part": "motherboard",
          "label": "Motherboard"
        },
        {
          "part": "ram",
          "label": "RAM"
        }
      ],
      "explanation": "The copper **heat pipe** carries heat to the fan, and the **battery connector** joins the battery to the board. The **motherboard** is the main board; the stick in its slot is **RAM**."
    },
    {
      "id": "q-phone-safe-order",
      "type": "drag_to_order",
      "difficulty": "core",
      "prompt": "A repair shop is swapping a phone camera. Put the steps in a **safe** order.",
      "items": [
        { "id": "soften", "label": "Soften the glue on the back cover" },
        { "id": "lift-back", "label": "Lift off the back cover" },
        { "id": "lift-bracket", "label": "Lift off the battery connector's bracket" },
        { "id": "unplug", "label": "Unplug the battery" },
        { "id": "swap-camera", "label": "Take out the broken camera" }
      ],
      "explanation": "The battery is **unplugged before** the camera, or any other part, is touched. Repair shops use special tools and training: never try this at home."
    },
    {
      "id": "q-make-room-in-ram",
      "type": "simulator",
      "difficulty": "core",
      "prompt": "You need **Maps** for directions, with your **music** still playing. Get the phone running smoothly.",
      "model": "memory",
      "params": {
        "ramGb": 6,
        "systemGb": 2,
        "apps": [
          {
            "id": "maps",
            "label": "Maps",
            "gb": 1
          },
          {
            "id": "music",
            "label": "Music",
            "gb": 0.4
          },
          {
            "id": "game",
            "label": "Racing game",
            "gb": 2.5
          },
          {
            "id": "video-call",
            "label": "Video call",
            "gb": 1.5
          },
          {
            "id": "browser",
            "label": "Web browser",
            "gb": 1
          }
        ]
      },
      "controls": [
        {
          "id": "maps",
          "kind": "toggle",
          "label": "Maps"
        },
        {
          "id": "music",
          "kind": "toggle",
          "label": "Music",
          "initial": true
        },
        {
          "id": "game",
          "kind": "toggle",
          "label": "Racing game",
          "initial": true
        },
        {
          "id": "video-call",
          "kind": "toggle",
          "label": "Video call",
          "initial": true
        },
        {
          "id": "browser",
          "kind": "toggle",
          "label": "Web browser",
          "initial": true
        }
      ],
      "outputs": [
        {
          "id": "smooth",
          "kind": "device",
          "label": "Phone",
          "frame": "phone"
        },
        {
          "id": "usedPct",
          "kind": "bar",
          "label": "RAM used"
        },
        {
          "id": "apps",
          "kind": "list",
          "label": "What's in RAM"
        }
      ],
      "goal": {
        "all": [
          {
            "target": "control",
            "id": "maps",
            "op": "==",
            "value": true
          },
          {
            "target": "control",
            "id": "music",
            "op": "==",
            "value": true
          },
          {
            "target": "output",
            "id": "smooth",
            "op": ">=",
            "value": 0.9
          }
        ]
      },
      "explanation": "Maps didn't fit in RAM alongside everything else. Closing the game (or the video call and the browser) makes room."
    },
    {
      "id": "q-whats-struggling",
      "type": "sort_bins",
      "difficulty": "core",
      "prompt": "What's most likely causing each problem?",
      "bins": [
        {
          "id": "ram",
          "label": "RAM is full"
        },
        {
          "id": "storage",
          "label": "Storage is full"
        },
        {
          "id": "heat",
          "label": "CPU is too hot"
        }
      ],
      "items": [
        {
          "id": "too-many-apps",
          "label": "Slow when lots of apps are open at once",
          "bin": "ram"
        },
        {
          "id": "tabs",
          "label": "Everything lags with 40 tabs open",
          "bin": "ram"
        },
        {
          "id": "cant-save",
          "label": "\"Can't save photo: not enough space\"",
          "bin": "storage"
        },
        {
          "id": "download-fails",
          "label": "A big download stops, saying it's full",
          "bin": "storage"
        },
        {
          "id": "fan-roaring",
          "label": "Fan roaring, then the laptop slows down",
          "bin": "heat"
        },
        {
          "id": "on-bed",
          "label": "Laptop slows down only when on a cushion",
          "bin": "heat"
        }
      ],
      "explanation": "Lag with lots of apps or tabs means **RAM**. Space messages mean **storage**. A roaring fan or blocked vents mean the CPU is **throttling**."
    },
    {
      "id": "q-no-charge",
      "type": "scenario",
      "difficulty": "core",
      "prompt": "Your tablet won't charge.",
      "start": "first",
      "steps": [
        {
          "id": "first",
          "text": "What do you try **first**?",
          "choices": [
            {
              "id": "other-cable",
              "text": "A different cable and plug socket",
              "consequence": "The simplest fix first. Cables wear out far more often than tablets.",
              "outcome": "success"
            },
            {
              "id": "metal",
              "text": "Scrape the port with a metal pin",
              "consequence": "Never put metal in a charging port. It can damage it or short it out.",
              "outcome": "fail"
            },
            {
              "id": "open-it",
              "text": "Open the tablet to check the battery",
              "consequence": "Opening a device is for adults and repair shops, and it should never be the first step.",
              "outcome": "fail"
            }
          ]
        }
      ],
      "explanation": "Start with the **simplest, safest** fix: another cable and socket. Never put metal in the port, and leave opening devices to adults and repair shops."
    },
    {
      "id": "q-stretch-battery",
      "type": "simulator",
      "difficulty": "core",
      "prompt": "A theme park day with **location on** for the map. Make the battery last **at least 10 hours**.",
      "model": "battery",
      "params": {
        "wattHours": 15
      },
      "controls": [
        {
          "id": "brightness",
          "kind": "slider",
          "label": "Screen brightness",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%"
        },
        {
          "id": "music",
          "kind": "toggle",
          "label": "Music",
          "initial": true
        },
        {
          "id": "gps",
          "kind": "toggle",
          "label": "Location",
          "initial": true
        },
        {
          "id": "backgroundApps",
          "kind": "toggle",
          "label": "Background apps",
          "initial": true
        },
        {
          "id": "lowPower",
          "kind": "toggle",
          "label": "Low power mode"
        }
      ],
      "outputs": [
        {
          "id": "hours",
          "kind": "meter",
          "label": "Battery lasts",
          "unit": "hours"
        },
        {
          "id": "watts",
          "kind": "meter",
          "label": "Power used",
          "unit": "W"
        }
      ],
      "goal": {
        "all": [
          {
            "target": "output",
            "id": "hours",
            "op": ">=",
            "value": 10
          },
          {
            "target": "control",
            "id": "gps",
            "op": "==",
            "value": true
          }
        ]
      },
      "explanation": "With location on, cut the other drains: lower brightness, background apps off, or low power mode. Music uses very little."
    },
    {
      "id": "q-fix-it-loop",
      "type": "drag_to_order",
      "difficulty": "core",
      "prompt": "Your camera says **\"Storage full\"**. Put what you do in fix-it-loop order.",
      "items": [
        {
          "id": "describe",
          "label": "Read exactly what the message says"
        },
        {
          "id": "guess",
          "label": "Guess big videos are filling storage"
        },
        {
          "id": "try",
          "label": "Delete videos you've already backed up"
        },
        {
          "id": "check",
          "label": "Try taking the photo again"
        }
      ],
      "explanation": "**Describe, guess, try, check.** The message points to storage, deleting backed-up videos is safe, and retrying checks it worked."
    },
    {
      "id": "q-disguised-file",
      "type": "multiple_choice",
      "difficulty": "core",
      "prompt": "A download is called `game-skins.jpg.exe`. What is it?",
      "options": [
        {
          "id": "program",
          "text": "A program, because the last part is .exe"
        },
        {
          "id": "picture",
          "text": "A picture, because the name has .jpg in it"
        },
        {
          "id": "folder",
          "text": "A folder, because its name has two dots"
        }
      ],
      "correctOptionId": "program",
      "explanation": "Only the **last** extension counts: `.exe` is a program dressed up as a picture. Leave it unopened."
    }
  ]
}
