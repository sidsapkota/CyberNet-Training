# CyberNet Training: environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is git-ignored;
# never commit real values, and never put real values in THIS file (it is committed).
# Restart `npm run dev` after changing env files.
#
# Find both values in the Supabase dashboard: Project Settings → API Keys (Publishable key)
# and Project Settings → Data API (Project URL). The "Connect" button on the project
# home page shows them too.

# Your project's API URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_). In older Supabase projects this is
# called the "anon" key (a long JWT starting with eyJ). It is safe to expose to the
# browser because Row Level Security decides what it can access.
#
# NEVER put the service_role key or a secret key (sb_secret_...) in a NEXT_PUBLIC_
# variable: anything prefixed NEXT_PUBLIC_ is bundled into client JavaScript and is
# visible to everyone. Server-only secrets, when needed later, get a name WITHOUT
# the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️  SERVER-ONLY SECRET. The SECRET key (starts with sb_secret_), from Project Settings →
# API Keys → Secret keys. It BYPASSES Row Level Security, so it can read and change every
# user's data.
#   - Put the real value ONLY in .env.local (git-ignored). Never here, never in chat, never
#     in a NEXT_PUBLIC_ variable.
#   - It's read only by src/lib/supabase/admin.ts, which is marked `server-only` so it can't
#     be bundled into browser code.
#   - Used for progress writes (so XP is always computed on the server) and account deletion.
# If it ever leaks, roll it immediately in the Supabase dashboard.
SUPABASE_SECRET_KEY=

# Optional. The public site address, used for canonical URLs, link previews and the sitemap.
# Defaults to https://cybernettraining.com, so you only need this for a different domain
# (e.g. a staging site). Must be an https origin, with no path.
NEXT_PUBLIC_SITE_URL=


# ── CyberNet Pro (Stripe, TEST MODE ONLY; live keys are refused) ─────────────────────────────
# Server-only. Never NEXT_PUBLIC_. See docs/stripe-checklist.md for where each one comes from.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Founding Member (optional): a one-off price (price_...; a sandbox one locally) and the switch.
# The offer shows only with FOUNDER_OFFER=on. Leave it off unless you mean to sell it.
STRIPE_PRICE_FOUNDER=
FOUNDER_OFFER=
# Optional: when Pro launched (ISO date); accounts made before it get 30 days of Pro free.
PRO_LAUNCH_AT=

# ── Leagues (server-only) ───────────────────────────────────────────────────────────────────
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/leagues (hourly):
# settles finished weeks and sends the daily handle-report summary. At least 16 random characters.
CRON_SECRET=
# Resend API key with "Sending access" for cybernettraining.com (the daily report summary email).
RESEND_API_KEY=
